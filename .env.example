# Copia este archivo a .env y cambia los valores antes de levantar docker compose.
POSTGRES_PASSWORD=cambia-esta-contrasena
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=CambiaEsto123
# Puerto donde se publica la aplicación
HTTP_PORT=8080

# Entrar con Microsoft 365 (opcional). Registra una app en Entra ID con la URL de respuesta
#   https://TU-DOMINIO/api/auth/signin-microsoft
# Microsoft exige HTTPS fuera de localhost.
MICROSOFT_LOGIN_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# true: cualquiera de tu organización puede entrar y se le crea su cuenta.
# false: solo entran quienes un administrador ya dio de alta con su correo.
MICROSOFT_AUTO_PROVISION=true

# Correo (opcional). Leer el buzón de ayuda crea tickets; enviar avisa al solicitante.
# Dirección pública de la aplicación, para los enlaces de los correos.
APP_URL=http://localhost:8080
# Leer el buzón: None, Graph (Microsoft 365) o Imap
EMAIL_INBOUND_PROVIDER=None
# Enviar avisos: None, Graph (Microsoft 365) o Smtp
EMAIL_OUTBOUND_PROVIDER=None
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Mesa de ayuda
# Área que recibe los tickets nuevos por correo (id). Vacío: la primera área que acepta solicitudes.
EMAIL_DEFAULT_AREA_ID=
# true: si escribe alguien sin cuenta, se le crea una de solicitante. false: se ignora su correo.
EMAIL_CREATE_UNKNOWN_SENDERS=true

# Microsoft 365: app en Entra ID con permisos de aplicación Mail.ReadWrite y Mail.Send
# (puede ser la misma app del inicio de sesión). Limítala al buzón con una Application Access Policy.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=

# Servidor IMAP / SMTP (si no usas Microsoft 365)
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
