# Copia este archivo a .env y cambia los valores antes de levantar docker compose.
POSTGRES_PASSWORD=cambia-esta-contrasena
ADMIN_EMAIL=admin@tuempresa.com
ADMIN_PASSWORD=CambiaEsto123
# Puerto donde se publica la aplicación
HTTP_PORT=8080

# Entrar con Microsoft 365 (opcional). Registra una app en Entra ID con la URL de respuesta
#   https://TU-DOMINIO/api/auth/signin-microsoft
# Microsoft exige HTTPS fuera de localhost.
MICROSOFT_LOGIN_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# true: cualquiera de tu organización puede entrar y se le crea su cuenta.
# false: solo entran quienes un administrador ya dio de alta con su correo.
MICROSOFT_AUTO_PROVISION=true
